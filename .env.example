# Copy to the deployment environment only after provisioning. Keep real values private.
PUBLIC_ORIGIN=https://drive.thebeng.dev
ADMIN_ORIGIN=https://beng-mini-pc.lamb-mine.ts.net
NODE_ENV=production
APP_MODE=production
# Required exact Tailscale owner login. Empty denies all admin requests and fails production validation.
ADMIN_OWNER_LOGIN=
# Admin uses /var/lib/beng-drive/admin.sock in the private state bind.
# Container-local SQLite path. Keep state on the host's local disk, never NAS.
DB_PATH=/var/lib/beng-drive/app.sqlite
HOST_BIND=0.0.0.0
CONTAINER_BIND=1
STATE_BIND_SOURCE=/home/beng/.local/share/beng-drive
NAS_BIND_SOURCE=/mnt/nas/workspace/beng-drive
FILE_MAX_BYTES=10000000000
DEFAULT_ALLOWANCE_BYTES=10000000000
FREE_SPACE_FLOOR_BYTES=10000000000
COLLECTION_MAX_FILES=1000
COLLECTION_DEFAULT_TTL_SECONDS=604800
UPLOAD_CHUNK_MAX_BYTES=10485760
SESSION_ACTIVE_TRANSFERS=2
CLEANUP_INTERVAL_SECONDS=3600
PARTIAL_IDLE_SECONDS=172800
